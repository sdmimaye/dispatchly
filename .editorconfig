root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yml,yaml,md}]
indent_size = 2

[*.cs]
dotnet_diagnostic.CA1068.severity = error
csharp_style_namespace_declarations = file_scoped:warning

[*.csproj]
indent_size = 2
